{
  "models": {
    "planner": "claude-opus-4-7",
    "executor": {
      "default": "claude-haiku-4-5-20251001",
      "implement_step": "claude-sonnet-4-6",
      "update_docs_step": "claude-haiku-4-5-20251001"
    },
    "validator_by_level": {
      "1": null,
      "2": "claude-haiku-4-5-20251001",
      "3": "claude-haiku-4-5-20251001",
      "4": "claude-sonnet-4-6",
      "5": "claude-opus-4-7"
    }
  },
  "validation": {
    "default_level": 1,
    "max_turns_by_level": {
      "1": 0,
      "2": 1,
      "3": 3,
      "4": 5,
      "5": 10
    }
  },
  "budgets": {
    "max_executor_turns": 20,
    "max_planner_turns": 200,
    "max_total_steps": 50
  },
  "hooks": {
    "ruff_on_edit": true,
    "commit_format_check": true,
    "bash_allowlist": [
      "pytest", "ruff", "mypy", "python", "pip",
      "git add", "git commit", "git status", "git diff",
      "git log", "curl", "cat", "ls", "pwd", "echo",
      "which", "find", "grep"
    ],
    "commit_message_pattern": "^(feat|fix|refactor|docs|chore|test)(\\(.+\\))?: .{1,72}$"
  }
}
